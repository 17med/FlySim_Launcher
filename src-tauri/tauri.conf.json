{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fly Simulator Launcher",
  "version": "0.3.3",
  "identifier": "com.flysim.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fly Simulator Launcher",
        "width": 1180,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://i.ytimg.com; style-src 'self'; script-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNEQ4MUYxMTBCNzk3MzkKUldRNWw3Y1E4WUZONDlpQWk3OW5sL2pON0FTSlZkWTFaNkRJdlpnQXppQ3BLU2Vaek92VVZDYXQK",
      "endpoints": [
        "https://github.com/17med/FlySim_Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
